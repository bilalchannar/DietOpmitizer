# Copy this file to .env and fill in your values.
# NEVER commit the real .env to version control.

# Credentials for the Mongo Express admin UI (http://localhost:8081)
MONGO_EXPRESS_USER=admin
MONGO_EXPRESS_PASS=changeme_please

# Comma-separated list of frontend origins the API will accept CORS requests from
CORS_ORIGINS=http://localhost,http://127.0.0.1,http://localhost:80
